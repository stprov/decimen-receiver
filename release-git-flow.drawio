ative="1" as="geometry"/></mxCell><mxCell id="H2M2" value="" style="html=1;endArrow=block;endFill=1;endSize=8;dashed=1;strokeColor=#b85450;strokeWidth=3;rounded=0;" edge="1" parent="1" source="H2" target="M2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="H2D6" value="" style="html=1;endArrow=block;endFill=1;endSize=8;dashed=1;strokeColor=#b85450;strokeWidth=3;rounded=0;" edge="1" parent="1" source="H2" target="D6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b1" value="1" style="ellipse;html=1;fillColor=#111827;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="494" y="496" width="22" height="22" as="geometry"/></mxCell><mxCell id="b2" value="2" style="ellipse;html=1;fillColor=#111827;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="716" y="396" width="22" height="22" as="geometry"/></mxCell><mxCell id="b3" value="3" style="ellipse;html=1;fillColor=#111827;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="794" y="296" width="22" height="22" as="geometry"/></mxCell><mxCell id="b4" value="4" style="ellipse;html=1;fillColor=#111827;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="874" y="296" width="22" height="22" as="geometry"/></mxCell><mxCell id="b5" value="5" style="ellipse;html=1;fillColor=#111827;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="954" y="296" width="22" height="22" as="geometry"/></mxCell><mxCell id="b6" value="6" style="ellipse;html=1;fillColor=#111827;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1118" y="122" width="22" height="22" as="geometry"/></mxCell><mxCell id="b7" value="7" style="ellipse;html=1;fillColor=#111827;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1234" y="196" width="22" height="22" as="geometry"/></mxCell><mxCell id="panel_title" value="Этапы" style="text;html=1;fontSize=15;fontStyle=1;align=left;fontColor=#1f2937;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="300" height="24" as="geometry"/></mxCell><mxCell id="step1" value="&lt;b&gt;1. Разработка&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;Ветка от develop под задачу Jira. PR в develop с ревью и ключом задачи в коммитах.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#111827;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="732" width="208" height="118" as="geometry"/></mxCell><mxCell id="step2" value="&lt;b&gt;2. Code freeze&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;Все PR релиза влиты, сборка develop зелёная. Срез объявлен в чате команды.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8db;strokeColor=#c9a227;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#111827;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="238" y="732" width="208" height="118" as="geometry"/></mxCell><mxCell id="step3" value="&lt;b&gt;3. Создание release&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;Только Jenkins-джобой от HEAD origin/develop. Хеш коммита среза записан в Jira.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8db;strokeColor=#c9a227;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#111827;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="456" y="732" width="208" height="118" as="geometry"/></mxCell><mxCell id="step4" value="&lt;b&gt;4. Проверки состава&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;1: HEAD develop входит в release. 2: у каждой задачи релиза есть коммит в ветке.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff8db;strokeColor=#c9a227;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#111827;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="674" y="732" width="208" height="118" as="geometry"/></mxCell><mxCell id="step5" value="&lt;b&gt;5. Сборка и проверки&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;Дистрибутив D-XX.XXX.XX_N, затем RQG, ФТ, ПСИ, ФПД по Release 2.0.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#111827;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="892" y="732" width="208" height="118" as="geometry"/></mxCell><mxCell id="step6" value="&lt;b&gt;6. Внедрение&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;Установка на ПРОМ по PoB, тег версии, обратный мёрж release в develop.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#111827;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1110" y="732" width="208" height="118" as="geometry"/></mxCell><mxCell id="step7" value="&lt;b&gt;7. Хотфикс&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4b5563&quot;&gt;От тега на ПРОМ, те же проверки, номер сборки +1, мёрж в master и develop.&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d1d5db;strokeWidth=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;fontSize=12;fontColor=#111827;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1328" y="732" width="208" height="118" as="geometry"/></mxCell><mxCell id="leg_new" value="Новые контрольные точки (КМ VUXPCAP-1667)" style="rounded=1;arcSize=20;html=1;fillColor=#fff8db;strokeColor=#c9a227;strokeWidth=2;fontSize=12;fontColor=#111827;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="870" width="330" height="28" as="geometry"/></mxCell><mxCell id="leg_merge" value="- - ▶  мёрж через PR" style="text;html=1;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="370" y="870" width="170" height="28" as="geometry"/></mxCell><mxCell id="leg_tag" value="тег" style="rounded=1;arcSize=30;html=1;fillColor=#1f5fa8;strokeColor=none;fontColor=#ffffff;fontSize=11;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="550" y="874" width="50" height="20" as="geometry"/></mxCell><mxCell id="leg_tag_t" value="версия, установленная на ПРОМ" style="text;html=1;fontSize=12;fontColor=#374151;align=left;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="606" y="870" width="220" height="28" as="geometry"/></mxCell><mxCell id="anti" value="&lt;b&gt;Запрещено:&lt;/b&gt; создавать release от локального или устаревшего develop и вливать задачи релиза после code freeze (причина дефекта VUXPCAP-1556)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fef2f2;strokeColor=#dc2626;fontSize=12;fontColor=#7f1d1d;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="866" width="700" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>